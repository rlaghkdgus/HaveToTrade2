--- !u!114 &5432796607342873818
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5432796607342873821}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb1befaad8f08734caa185b6464094c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DialogDB: {fileID: 11400000, guid: 9f60775824b7cf642a61f287c5878bcf, type: 2}
  branch: 0
  selectedDialogName: Tutorial_3
  speakers:
  - SpeakerImage: {fileID: 0}
  - SpeakerImage: {fileID: 0}
  - SpeakerImage: {fileID: 0}
  - SpeakerImage: {fileID: 0}
  - SpeakerImage: {fileID: 0}
  - SpeakerImage: {fileID: 0}
  - SpeakerImage: {fileID: 0}
  - SpeakerImage: {fileID: 0}
  dialogs:
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uC88B\uC544, \uADF8\uB7F0 \uC2DD\uC73C\uB85C \uB0B4 \uD604\uC7AC \uC790\uAE08
      \uC0C1\uD669\uC5D0 \uB9DE\uAC8C \uB054 \uAC1C\uC218\uB97C \uC870\uC808\uD574\uC57C
      \uB3FC."
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC "
    dialog: "\uC22B\uC790 \uCE78\uC744 \uB204\uB974\uBA74 \uC9C1\uC811 \uAC12 \uC785\uB825\uB3C4
      \uAC00\uB2A5\uD574."
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uADF8\uB7FC \uB2E4\uC74C\uC73C\uB85C \uAC70\uB798\uC5D0\uC11C \uC81C\uC77C
      \uC911\uC694\uD55C \uC694\uC18C! \uD765\uC815\uC774\uC57C."
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uD765\uC815\uC740 \uD604\uC7AC \uBB3C\uD488\uC758 \uAC00\uACA9\uC5D0\uC11C
      \uAD6C\uB9E4 \uC2DC\uC5D0\uB294 \uAC00\uACA9\uC744 \uC904\uC774\uACE0, \uD310\uB9E4
      \uC2DC\uC5D0\uB294 \uAC00\uACA9\uC744 \uB298\uB9B4 \uC218 \uC788\uB294 \uC218\uB2E8\uC774\uC57C"
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uD765\uC815 \uD654\uBA74\uC5D0\uC11C \uBCF8\uC778\uC774 \uC6D0\uD558\uB294
      \uAC12\uC744 \uC785\uB825\uD558\uACE0 \uD765\uC815\uC744 \uC2DC\uB3C4\uD558\uBA74
      \uB3FC!"
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uB2E4\uB9CC \uC0C1\uB300\uB3C4 \uC774\uC724\uC774 \uC788\uC5B4\uC57C
      \uD558\uB294 \uB9CC\uD07C \uAE30\uC874 \uAC00\uACA9\uACFC \uB108\uBB34 \uCC28\uC774\uAC00
      \uB098\uBA74 \uB2F9\uC5F0\uD788 \uAC70\uC808\uD560 \uD655\uB960\uC774 \uB192\uACA0\uC9C0?"
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uC0C1\uB300\uAC00 \uBC1B\uC544\uB4E4\uC77C \uC218 \uC788\uB294 \uC801\uC808\uD55C
      \uAE08\uC561\uC744 \uC81C\uC2DC\uD558\uB294 \uAC8C \uD575\uC2EC\uC774\uC57C!"
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uC774\uBC88\uC5D0\uB294 \uC77C\uB2E8 \uAD6C\uB9E4\uD574\uBCFC\uAE4C?
      \uBE75\uC774 \uBA39\uACE0 \uC2F6\uC5B4\uC84C\uC5B4!"
  Name: {fileID: 0}
  Dialog: {fileID: 0}
