--- !u!114 &1457279102
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1457279099}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb1befaad8f08734caa185b6464094c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DialogDB: {fileID: 11400000, guid: 9f60775824b7cf642a61f287c5878bcf, type: 2}
  branch: 0
  selectedDialogName: Tutorial_4
  speakers:
  - SpeakerImage: {fileID: 745788185}
  - SpeakerImage: {fileID: 722557723}
  - SpeakerImage: {fileID: 1973657368}
  - SpeakerImage: {fileID: 919943817}
  - SpeakerImage: {fileID: 722557723}
  - SpeakerImage: {fileID: 722557723}
  - SpeakerImage: {fileID: 722557723}
  - SpeakerImage: {fileID: 722557723}
  dialogs:
  - speakerIndex: 2
    name: "\uBC31\uD638"
    dialog: "\uC5B8\uB2C8, \uC0C1\uC778\uAE38\uB4DC\uB3C4 \uB05D! \uC774\uC81C \uC2DC\uC7A5
      \uB3CC\uC544\uAC00\uC11C \uAC70\uB798\uD558\uB7EC \uAC00\uC790! "
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uC88B\uC544, \uBC31\uD638! \uC2DC\uC7A5\uC5D0\uC11C \uB354 \uD070 \uAC70\uB798\uB97C
      \uD558\uC790!"
  - speakerIndex: 1
    name: 
    dialog: "\uBBF8\uB808\uC0AC\uC640 \uBC31\uD638\uB294 \uC2DC\uC7A5\uC758 \uD65C\uAE30
      \uC18D\uC5D0\uC11C \uB3CC\uC544\uAC14\uB2E4. \uD587\uC0B4 \uC544\uB798 \uB9C8\uC744\uC774
      \uC0DD\uAE30\uB85C \uBE5B\uB0AC\uB2E4."
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uBC31\uD638, \uC624\uB298 \uD558\uB8E8 \uC9C4\uC9DC \uB300\uBC15\uC774\uC5C8\uC5B4!
      \uBB3C\uB860 \uC2E4\uD328\uB3C4 \uC788\uC5C8\uC9C0\uB9CC, \uC131\uACF5\uD560
      \uB54C \uC2EC\uC7A5\uC774 \uCFF5\uCFF5 \uB6F0\uC5C8\uC5B4!"
  - speakerIndex: 2
    name: "\uBC31\uD638"
    dialog: "\uC5B8\uB2C8, \uCD08\uBCF4\uCE58\uACE4 \uC798\uD588\uC5B4! \uC5B4\uC5FF\uD55C
      \uBB34\uC5ED\uC0C1 \uAC19\uC558\uB294\uAC78?"
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uBC31\uD638, \uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4? \uB098\uB294
      \uB108\uB791 \uAC19\uC774 \uC788\uC5B4\uC11C \uC9C4\uC9DC \uC7AC\uBC0C\uC5C8\uC5B4!"
  - speakerIndex: 2
    name: "\uBC31\uD638"
    dialog: "\uB098\uB3C4 \uC88B\uC558\uC5B4! \uC55E\uC73C\uB85C\uB3C4 \uCB49\uCB49
      \uAC70\uB798\uD558\uACE0 \uD6CC\uB96D\uD55C \uC0C1\uC778\uC774 \uB418\uB294
      \uAC70\uC57C!"
  - speakerIndex: 1
    name: 
    dialog: "\uBBF8\uB808\uC0AC\uC640 \uBC31\uD638\uB294 \uC2DC\uC7A5 \uB05D\uCABD
      \uB178\uC810\uC744 \uD5A5\uD574 \uC2DC\uC120\uC744 \uB3CC\uB838\uB2E4. \uD587\uC0B4
      \uC544\uB798 \uC0C8\uB85C\uC6B4 \uAE30\uD68C\uAC00 \uAE30\uB2E4\uB9B0\uB2E4."
  Name: {fileID: 1260186516}
  Dialog: {fileID: 1260186515}
  dialogUI: {fileID: 1260186514}
  DialogBG: {fileID: 344150113}
  isAutoStart: 1
  isFirst: 1
