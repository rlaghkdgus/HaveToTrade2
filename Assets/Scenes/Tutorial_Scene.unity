    name: "\uC740\uD589\uC9C1\uC6D0"
    dialog: "\uC548\uB155\uD558\uC138\uC694. \uC0C8 \uBB34\uC5ED\uC0C1\uC774\uC2DC\uC8E0?
      \uC5EC\uAE34 \uC740\uD589\uC774\uC5D0\uC694. \uCFE0\uD37C \uB300\uCD9C\uC744
      \uAD00\uB9AC\uD558\uACE0, \uBE5A\uC744 \uC0C1\uD658\uD558\uB294 \uACF3\uC774\uC8E0.
      \uB3C8\uC740 \uC800\uD76C\uAC00 \uC5B8\uC81C\uB098 \uC548\uC804\uD558\uAC8C
      \uC9C0\uD0A4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uC548\uB155\uD558\uC138\uC694! \uC740\uD589\uC5D0\uC11C \uCFE0\uD37C\uB97C
      \uBE4C\uB838\uB294\uB370, \uC5EC\uAE30\uC11C \uC0C1\uD658\uD558\uB294 \uAC70
      \uB9DE\uC8E0? \uBA85\uC131\uB3C4 \uC54C\uB824\uC8FC\uC138\uC694!"
  - speakerIndex: 4
    name: "\uC740\uD589\uC9C1\uC6D0"
    dialog: "\uB9DE\uC544\uC694, \uB300\uCD9C \uC0C1\uD658\uC740 \uC5EC\uAE30\uC11C
      \uD558\uBA74 \uB3FC\uC694. \uC9C0\uAE08 \uC0C1\uD658\uD560 \uCFE0\uD37C \uC788\uC73C\uC2DC\uBA74
      \uAE30\uB85D\uD560\uAC8C\uC694."
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uC0C1\uD658\uC740 \uC544\uC9C1 \uCFE0\uD37C\uAC00 \uBAA8\uC790\uB77C\uC11C
      \uB098\uC911\uC5D0 \uB2E4\uC2DC \uC624\uB3C4\uB85D \uD560\uAC8C\uC694!"
  - speakerIndex: 4
    name: "\uC740\uD589\uC9C1\uC6D0"
    dialog: "\uD558\uD558, \uCC9C\uCC9C\uD788 \uD574\uB3C4 \uAD1C\uCC2E\uC544\uC694.
      \uBA85\uC131 \uC313\uACE0, \uBB34\uC5ED \uC131\uACF5\uD574\uC11C \uC740\uD589\uC5D0\uC11C
      \uC790\uC8FC \uBCF4\uC790\uACE0\uC694!"
  - speakerIndex: 0
    name: "\uBBF8\uB808\uC0AC"
    dialog: "\uACE0\uB9C8\uC6CC\uC694, \uC5B8\uB2C8! \uB2E4\uC74C\uC5D4 \uC0C1\uD658\uD558\uACE0
      \uBA85\uC131\uB3C4 \uC313\uC544\uC11C \uC62C \uAC70\uC57C!"
  - speakerIndex: 1
    name: 
    dialog: "\uBBF8\uB808\uC0AC\uB294 \uC740\uD589\uC5D0\uC11C \uBE5A \uC0C1\uD658\uACFC
      \uBA85\uC131 \uC2DC\uC2A4\uD15C\uC744 \uBC30\uC6B0\uACE0, \uBB34\uC5ED\uC758
      \uD070 \uADF8\uB9BC\uC744 \uADF8\uB838\uB2E4. \uBC31\uD638\uAC00 \uC5B4\uAE68\uC5D0\uC11C
      \uD0A5\uD0A5 \uC6C3\uC5C8\uB2E4."
  Name: {fileID: 1260186516}
  Dialog: {fileID: 1260186515}
  dialogUI: {fileID: 1260186514}
  DialogBG: {fileID: 344150113}
  isAutoStart: 1
  isFirst: 1
