%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 8
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48e2872be59c44544a7325575ad42578, type: 3}
  m_Name: DialogData
  m_EditorClassIdentifier: 
  Tutorial_1:
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uB300\uBB34\uC5ED\uC2DC\uB300\uC758 \uC6C5\uC7A5\uD55C \uAE30\uC6B4\uC774
      \uC138\uC0C1\uC744 \uD718\uAC10\uC558\uB2E4. \uBC14\uB2E4\uB97C \uAC00\uB85C\uC9C0\uB974\uB294
      \uC0C1\uC120\uACFC \uB300\uB959\uC744 \uC787\uB294 \uC218\uB808\uAC00 \uB04A\uC784\uC5C6\uC774
      \uC624\uAC14\uB2E4. \uACE1\uBB3C, \uD5A5\uC2E0\uB8CC, \uBCF4\uC11D\uC774 \uC2DC\uC7A5\uC744
      \uCC44\uC6B0\uBA70, \uBAA8\uB450\uAC00 \uBD80\uC640 \uBA85\uC608\uB97C \uAFC8\uAFE8\uB2E4."
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uC774 \uB9C8\uC744\uC758 \uC2DC\uC7A5\uC740 \uADF8 \uAFC8\uC758 \uC2EC\uC7A5\uC774\uC5C8\uB2E4.
      \uD587\uC0B4 \uC544\uB798 \uD669\uAE08\uBE5B \uBC00 \uD5A5\uAE30\uAC00 \uD37C\uC9C0\uACE0,
      \uC0C1\uC778\uB4E4\uC758 \uD65C\uAE30\uCC2C \uC678\uCE68\uC774 \uACE8\uBAA9\uC744
      \uBA54\uC6E0\uB2E4."
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uC624\uB298, \uC0C8\uB85C\uC6B4 \uBB34\uC5ED\uC0C1\uC774 \uC2DC\uC7A5
      \uD55C\uBCF5\uD310\uC5D0 \uC130\uB2E4. \uB2A6\uC740 \uCD9C\uBC1C\uC774\uC5C8\uC9C0\uB9CC,
      \uADF8\uB140\uC758 \uB208\uBE5B\uC740 \uB728\uAC70\uC6B4 \uC758\uC9C0\uB85C
      \uBD88\uD0C0\uC62C\uB790\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC640, \uC774 \uC2DC\uC7A5 \uC9C4\uC9DC \uC0B4\uC544\uC788\uB124! \uC5EC\uAE30\uC11C
      \uB0B4 \uBB34\uC5ED \uBAA8\uD5D8\uC774 \uC2DC\uC791\uB420 \uAC70\uC57C! (\uB108\uBB34
      \uC124\uB80C\uB2E4!)"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC880 \uB2A6\uAC8C \uB6F0\uC5B4\uB4E4\uC5C8\uC9C0\uB9CC, \uC9C0\uAE08\uBD80\uD130
      \uC5F4\uC2EC\uD788 \uD558\uBA74 \uB2E4 \uB530\uB77C\uC7A1\uC744 \uC218 \uC788\uC744
      \uAC70\uC57C!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uB294 \uB0A1\uC740 \uAC00\uC8FD \uBC30\uB0AD\uC744
      \uBA54\uACE0 \uC2DC\uC7A5\uC758 \uC18C\uC74C \uC18D\uC5D0 \uC130\uB2E4. \uBC30\uB0AD
      \uC548\uC5D0\uB294 \uC740\uD589\uC5D0\uC11C \uBE4C\uB9B0 \uB3C8\uACFC \uD488\uC9C8
      \uC88B\uC740 \uBC00 \uC790\uB8E8\uAC00 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC774 \uB3C8\uC73C\uB85C \uC791\uC740 \uAC70\uB798\uBD80\uD130 \uC2DC\uC791\uD574\uC11C
      \uC810\uC810 \uD0A4\uC6B8 \uAC70\uC57C. \uCCAB \uAC70\uB798, \uAF2D \uD574\uB0BC
      \uAC70\uC57C!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uC2DC\uC7A5\uC5D0\uB294 \uD587\uC0B4\uC774 \uBE44\uCE58\uBA70 \uC0DD\uAE30\uAC00
      \uB118\uCCE4\uB2E4. \uC0C1\uC778\uB4E4\uC758 \uD638\uAC1D \uC18C\uB9AC, \uD765\uC815
      \uB300\uD654, \uC9D0\uC218\uB808\uC758 \uBC14\uD034 \uAD74\uB7EC\uAC00\uB294
      \uC18C\uB9AC\uAC00 \uC5B4\uC6B0\uB7EC\uC838 \uD65C\uB825\uC744 \uBFDC\uC5B4\uB0C8\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uACE1\uBB3C, \uC0DD\uC120, \uD5A5\uC2E0\uB8CC \uB0C4\uC0C8\uAC00 \uB4A4\uC11E\uC5EC\uC11C
      \uBA38\uB9AC\uAC00 \uC5B4\uC9C0\uB7EC\uC6B8 \uC815\uB3C4\uC57C. \uC774\uACF3\uC5D0\uC11C
      \uBB34\uC5ED \uC2DC\uC791\uD558\uB294 \uAC70, \uC9C4\uC9DC \uBA4B\uC9C0\uB2E4!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uC2DC\uC7A5 \uB178\uC810\uC5D4 \uD654\uB824\uD55C \uBB3C\uAC74\uB4E4\uC774
      \uAC00\uB4DD\uD588\uB2E4. \uBD89\uC740 \uD5A5\uC2E0\uB8CC \uD56D\uC544\uB9AC,
      \uBC18\uC9DD\uC774\uB294 \uC7A5\uC2E0\uAD6C, \uC2E0\uC120\uD55C \uCC44\uC18C\uC640
      \uC0DD\uC120\uC774 \uB208\uC744 \uC0AC\uB85C\uC7A1\uC558\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC0AC\uB78C\uB4E4\uC774 \uC5B4\uB5A4 \uBB3C\uAC74\uC744 \uC88B\uC544\uD558\uB294\uC9C0
      \uC54C\uC544\uB0B4\uC57C \uD574. \uB0B4 \uBC00\uC740 \uC5B4\uB514\uC11C \uC81C\uC77C
      \uBE44\uC2F8\uAC8C \uD314 \uC218 \uC788\uC744\uAE4C?"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uB294 \uB178\uC810 \uAC04\uD310\uC744 \uAF3C\uAF3C\uD788
      \uC77D\uC73C\uBA70 \uC0C1\uC778\uB4E4\uC758 \uB300\uD654\uB97C \uADC0 \uAE30\uC6B8\uC5EC
      \uB4E4\uC5C8\uB2E4. \uBA54\uBAA8\uC7A5\uC5D0 \uBC00 \uAC00\uACA9\uACFC \uC2DC\uC7A5
      \uD750\uB984\uC744 \uAE30\uB85D\uD588\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC815\uBCF4\uAC00 \uBB34\uC5ED\uC758 \uD575\uC2EC\uC774\uB77C\uB358\uB370,
      \uC544\uC9C1\uC740 \uC880 \uBCF5\uC7A1\uD558\uB2E4. \uADF8\uB798\uB3C4 \uD558\uB098\uC529
      \uBC30\uC6B0\uBA74\uC11C \uB2E4 \uD574\uB0BC \uAC70\uC57C!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC "
    Dialog: "\uC88B\uC544, \uC6B0\uC120 \uAC70\uB798\uBD80\uD130 \uD574\uBCFC\uAE4C?"
  BreadShop_B:
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uAC00 \uC2DC\uC7A5 \uC18C\uC74C\uC5D0 \uC775\uC219\uD574\uC9C8
      \uBB34\uB835, \uD48D\uAE30\uB294 \uBE75 \uB0C4\uC0C8\uC5D0 \uC774\uB04C\uB9AC\uB4EF
      \uBE75 \uAC00\uAC8C \uC55E\uC73C\uB85C \uD5A5\uD588\uB2E4."
  - SpeakerIndex: 3
    Name: "\uBE75\uC0C1\uC778"
    Dialog: "\uC548\uB155. \uC0C8 \uC5BC\uAD74\uC774\uB124! \uC774 \uBE75\uC740 \uC774
      \uB9C8\uC744\uC5D0\uC11C\uB3C4 \uC720\uBA85\uD558\uB2E4\uACE0. 80\uCFE0\uD37C\uC5D0
      \uC904\uAC8C. \uC5B4\uB54C, \uC0B4\uB798?"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC774 \uBE75, \uC5C4\uCCAD \uB9DB\uC788\uC5B4 \uBCF4\uC778\uB2E4! \uD55C
      \uBC88 \uC0AC\uBCFC\uAE4C?"
  Tutorial_2:
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uAC70\uB798\uC5D0\uC11C\uB294 \uAD6C\uB9E4, \uD310\uB9E4\uAC00 \uAC00\uC7A5
      \uAE30\uBCF8\uC774\uC57C!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uAC70\uB798 \uC0C1\uB300\uAC00 \uB098\uD55C\uD14C \uC6D0\uD558\uB294
      \uBB3C\uAC74\uC744 \uD310\uB9E4\uD560 \uC218\uB3C4 \uC788\uACE0, \uB0B4\uAC00
      \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC83 \uC911 \uC6D0\uD558\uB294 \uAC83\uC744
      \uC0AC\uB824 \uD560 \uC218\uB3C4 \uC788\uC5B4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC774 \uBC84\uD2BC\uB4E4\uC744 \uB20C\uB7EC\uBCFC\uB798?"
  Tutorial_3:
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC774 \uBC84\uD2BC\uC744 \uD1B5\uD574\uC11C \uB0B4\uAC00 \uC0B4 \uBB3C\uAC74\uC758
      \uAC1C\uC218\uB97C \uC870\uC808\uD558\uB294 \uAC70\uC57C. \uC22B\uC790 \uCE78\uC744
      \uB204\uB974\uBA74 \uC9C1\uC811 \uAC12 \uC785\uB825\uB3C4 \uAC00\uB2A5\uD574."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uADF8\uB7FC \uB2E4\uC74C\uC73C\uB85C \uAC70\uB798\uC5D0\uC11C \uC81C\uC77C
      \uC911\uC694\uD55C \uC694\uC18C! \uD765\uC815\uC774\uC57C."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uD765\uC815\uC740 \uD604\uC7AC \uBB3C\uD488\uC758 \uAC00\uACA9\uC5D0\uC11C
      \uAD6C\uB9E4 \uC2DC\uC5D0\uB294 \uAC00\uACA9\uC744 \uC904\uC774\uACE0, \uD310\uB9E4
      \uC2DC\uC5D0\uB294 \uAC00\uACA9\uC744 \uB298\uB9B4 \uC218 \uC788\uB294 \uC218\uB2E8\uC774\uC57C"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uD765\uC815 \uD654\uBA74\uC5D0\uC11C \uBCF8\uC778\uC774 \uC6D0\uD558\uB294
      \uAC12\uC744 \uC785\uB825\uD558\uACE0 \uD765\uC815\uC744 \uC2DC\uB3C4\uD558\uBA74
      \uB3FC!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uB2E4\uB9CC \uC0C1\uB300\uB3C4 \uC774\uC724\uC774 \uC788\uC5B4\uC57C
      \uD558\uB294 \uB9CC\uD07C \uAE30\uC874 \uAC00\uACA9\uACFC \uB108\uBB34 \uCC28\uC774\uAC00
      \uB098\uBA74 \uB2F9\uC5F0\uD788 \uAC70\uC808\uD560 \uD655\uB960\uC774 \uB192\uACA0\uC9C0?"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC0C1\uB300\uAC00 \uBC1B\uC544\uB4E4\uC77C \uC218 \uC788\uB294 \uC801\uC808\uD55C
      \uAE08\uC561\uC744 \uC81C\uC2DC\uD558\uB294 \uAC8C \uD575\uC2EC\uC774\uC57C!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC774\uBC88\uC5D0\uB294 \uC77C\uB2E8 \uAD6C\uB9E4\uD574\uBCFC\uAE4C?
      \uBE75\uC774 \uBA39\uACE0 \uC2F6\uC5B4\uC84C\uC5B4!"
  BreadShop_A:
  - SpeakerIndex: 3
    Name: "\uBE75\uC0C1\uC778"
    Dialog: "\uB2E4\uC74C\uC5D0\uB3C4 \uC88B\uC740 \uAC70\uB798 \uBD80\uD0C1\uD574!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uB2E4\uC74C\uC5D0 \uB610 \uBD10\uC694!"
  Tutorial_4:
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uB294 \uBE75\uC744 \uD558\uB098 \uC785\uC5D0 \uBB3C\uBA70
      \uC2DC\uC7A5\uC758 \uD65C\uAE30\uB97C \uB290\uAF08\uB2E4. \uCCAB \uAC70\uB798
      \uC131\uACF5\uC758 \uC124\uB818\uC774 \uAC00\uC2B4\uC744 \uCC44\uC6E0\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uBB3C\uD488\uC774 \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uC73C\uBA74
      \uAC70\uC808\uD574\uB3C4 \uAD1C\uCC2E\uB2E4\uB294 \uC810\uB3C4 \uD655\uC778\uD574\uB450\uACE0\u2026"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC774\uC81C \uB610 \uB2E4\uB978 \uBB3C\uAC74\uC744 \uCC3E\uC544\uBCFC\uAE4C?
      \uC800\uAE30 \uACFC\uC77C \uB178\uC810, \uC0AC\uACFC\uAC00 \uC2F1\uC2F1\uD574
      \uBCF4\uC5EC!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uB610 \uB2E4\uB978 \uAC70\uB798\uB97C \uC704\uD574 \uAC00\uBC29\uC744
      \uC5EC\uB294 \uC21C\uAC04, \uBC30\uB0AD \uC548\uC5D0\uC11C \uD76C\uBBF8\uD55C
      \uBE5B\uC774 \uC0C8\uC5B4 \uB098\uC654\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC774\uAC8C \uBB50\uC9C0? \uAC00\uBC29\uC744 \uC5F4\uC5C8\uB294\uB370
      \uC65C \uBE5B\uC774 \uB098\uB294 \uAC70\uC57C?"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uCFE0\uD37C\uAC00 \uBD80\uB52A\uD788\uB294 \uC18C\uB9AC \uC0AC\uC774\uB85C
      \uAE30\uBB18\uD55C \uAE30\uC6B4\uC774 \uD37C\uC84C\uB2E4. \uBE5B\uC774 \uC810\uCC28
      \uAC15\uD574\uC9C0\uBA70, \uD3F4\uC9DD! \uC190\uBC14\uB2E5\uB9CC \uD55C \uD770
      \uD638\uB791\uC774 \uC18C\uB140\uAC00 \uD280\uC5B4\uB098\uC654\uB2E4."
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uC9DC\uC794! \uBB34\uC5ED\uC0C1 \uC5B8\uB2C8. \uB4DC\uB514\uC5B4 \uB9CC\uB0AC\uB124!
      \uBC29\uAE08 \uADF8 \uBE75 \uD765\uC815, \uB05D\uB0B4\uC92C\uC5B4! \uC774 \uBC31\uD638\uAC00
      \uC774\uC81C\uBD80\uD130 \uB4E0\uB4E0\uD558\uAC8C \uB3C4\uC640\uC904\uAC8C!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uAC11\uC790\uAE30 \uBB50\uC57C, \uC774 \uADC0\uC5EC\uC6B4 \uD638\uB791\uC774\uB294
      \uC5B4\uB514\uC11C \uD280\uC5B4\uB098\uC628 \uAC70\uC9C0?! \uB0B4 \uD765\uC815
      \uBD24\uB2E4\uACE0?"
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uD765, \uADC0\uC5FD\uB2E4\uB2C8 \uBB34\uB840\uD574! \uB09C \uBC31\uD638.
      \uCD08! \uD2B9! \uAE09! \uC2E0\uBE44\uB85C\uC6B4 \uBB34\uC5ED \uAC00\uC774\uB4DC\uC57C!
      \uC5B8\uB2C8\uC758 \uCFE0\uD37C\uC5D0 \uB2F4\uAE34 \uBB34\uC5ED\uC758 \uAE30\uC6B4\uC774
      \uB0A0 \uBD88\uB800\uC9C0!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uBB34\uC5ED\uC758 \uAE30\uC6B4? \uADF8\uAC8C \uBB50\uC57C? \uC740\uD589
      \uCFE0\uD37C\uAC00 \uD2B9\uBCC4\uD55C \uAC70\uC600\uC5B4?"
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uB9DE\uC544, \uC5B8\uB2C8! \uC774 \uCFE0\uD37C\uB4E4\uC740 \uC774 \uB9C8\uC744\uC758
      \uBB34\uC5ED \uAE30\uC6B4\uC774 \uB2F4\uAE34 \uAC70\uC57C. \uB124 \uD765\uC815
      \uC131\uACF5\uC774 \uADF8 \uAE30\uC6B4\uC744 \uAE68\uC6E0\uACE0, \uADF8\uB798\uC11C
      \uB0B4\uAC00 \uD280\uC5B4\uB098\uC628 \uAC70\uC9C0!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uADF8\uB7FC \uB10C \uB0B4 \uD30C\uD2B8\uB108\uC57C? \uC88B\uC544, \uBC31\uD638!
      \uAC19\uC774 \uB300\uBC15 \uB098\uBCF4\uC790!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBC31\uD638\uAC00 \uC8FC\uC778\uACF5\uC758 \uC5B4\uAE68\uC5D0 \uD3F4\uC9DD
      \uC62C\uB77C\uD0C0\uBA70 \uCF54\uB97C \uD081\uD081\uAC70\uB838\uB2E4. \uD070
      \uB208\uC774 \uD587\uC0B4\uC744 \uBC1B\uC544 \uBC18\uC9DD\uC774\uACE0, \uB9AC\uBCF8
      \uAF2C\uB9AC\uAC00 \uC0B4\uB791\uC600\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uBC31\uD638, \uC774 \uBE75 \uB0C4\uC0C8 \uB9E1\uC544\uBD10! \uD55C
      \uC785 \uBA39\uC5B4\uBCFC\uB798?"
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uC778\uAC04 \uC74C\uC2DD\uC740 \uC548 \uBA39\uC5B4! \uB0C4\uC0C8\uB9CC
      \uB9E1\uC744\uAC8C! \uC5B8\uB2C8, \uC2DC\uC7A5 \uB9D0\uACE0 \uC911\uC694\uD55C
      \uAC74\uBB3C\uB4E4 \uBA3C\uC800 \uB458\uB7EC\uBCFC\uAE4C?"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC624 \uADF8\uAC70 \uC88B\uC740 \uC0DD\uAC01! \uC774 \uB9C8\uC744\uC5D0
      \uC740\uD589\uC774\uB791 \uAE38\uB4DC \uAC19\uC740 \uAC74\uBB3C\uB4E4 \uC788\uC796\uC544.
      \uC5B4\uB514\uBD80\uD130 \uAC08\uAE4C?"
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uC5B8\uB2C8, \uBA3C\uC800 \uC740\uD589 \uAC00\uBCF4\uC790! \uAC74\uBB3C\uC774
      \uC73C\uB9AC\uC73C\uB9AC\uD55C \uAC8C \uAC00\uBCF4\uACE0 \uC2F6\uC5B4!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uC640 \uBC31\uD638\uB294 \uC2DC\uC7A5 \uD55C\uCABD\uC5D0
      \uC790\uB9AC\uD55C \uC740\uD589 \uAC74\uBB3C\uB85C \uD5A5\uD588\uB2E4. \uB2E8\uB2E8\uD55C
      \uB3CC\uBB38 \uC704\uC5D0 \uCFE0\uD37C \uBAA8\uC591\uC774 \uC0C8\uACA8\uC838
      \uC788\uC5C8\uB2E4."
  Bank:
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uC5EC\uAE30\uAC00 \uC740\uD589\uC774\uC57C! \uBB54\uAC00 \uADFC\uC0AC\uD55C
      \uBD84\uC704\uAE30\uB124."
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uC740\uD589 \uC548\uC73C\uB85C \uB4E4\uC5B4\uC11C\uC790, \uC740\uD589\uC6D0\uC774
      \uB530\uB73B\uD55C \uBBF8\uC18C\uB85C \uC8FC\uC778\uACF5\uC744 \uB9DE\uC774\uD588\uB2E4."
  - SpeakerIndex: 1
    Name: "\uC740\uD589\uC9C1\uC6D0"
    Dialog: "\uC548\uB155\uD558\uC138\uC694. \uC0C8 \uBB34\uC5ED\uC0C1\uC774\uC2DC\uC8E0?
      \uC5EC\uAE34 \uC740\uD589\uC774\uC5D0\uC694. \uCFE0\uD37C \uB300\uCD9C\uC744
      \uAD00\uB9AC\uD558\uACE0, \uBE5A\uC744 \uC0C1\uD658\uD558\uB294 \uACF3\uC774\uC8E0.
      \uB3C8\uC740 \uC800\uD76C\uAC00 \uC5B8\uC81C\uB098 \uC548\uC804\uD558\uAC8C
      \uC9C0\uD0A4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC548\uB155\uD558\uC138\uC694! \uC740\uD589\uC5D0\uC11C \uCFE0\uD37C\uB97C
      \uBE4C\uB838\uB294\uB370, \uC5EC\uAE30\uC11C \uC0C1\uD658\uD558\uB294 \uAC70
      \uB9DE\uC8E0? \uBA85\uC131\uB3C4 \uC54C\uB824\uC8FC\uC138\uC694!"
  - SpeakerIndex: 1
    Name: "\uC740\uD589\uC9C1\uC6D0"
    Dialog: "\uB9DE\uC544\uC694, \uB300\uCD9C \uC0C1\uD658\uC740 \uC5EC\uAE30\uC11C
      \uD558\uBA74 \uB3FC\uC694. \uC9C0\uAE08 \uC0C1\uD658\uD560 \uCFE0\uD37C \uC788\uC73C\uC2DC\uBA74
      \uAE30\uB85D\uD560\uAC8C\uC694."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC0C1\uD658\uC740 \uC544\uC9C1 \uCFE0\uD37C\uAC00 \uBAA8\uC790\uB77C\uC11C
      \uB098\uC911\uC5D0 \uB2E4\uC2DC \uC624\uB3C4\uB85D \uD560\uAC8C\uC694!"
  - SpeakerIndex: 1
    Name: "\uC740\uD589\uC9C1\uC6D0"
    Dialog: "\uD558\uD558, \uCC9C\uCC9C\uD788 \uD574\uB3C4 \uAD1C\uCC2E\uC544\uC694.
      \uBA85\uC131 \uC313\uACE0, \uBB34\uC5ED \uC131\uACF5\uD574\uC11C \uC740\uD589\uC5D0\uC11C
      \uC790\uC8FC \uBCF4\uC790\uACE0\uC694!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uACE0\uB9C8\uC6CC\uC694, \uC5B8\uB2C8! \uB2E4\uC74C\uC5D4 \uC0C1\uD658\uD558\uACE0
      \uBA85\uC131\uB3C4 \uC313\uC544\uC11C \uC62C \uAC70\uC57C!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uB294 \uC740\uD589\uC5D0\uC11C \uBE5A \uC0C1\uD658\uACFC
      \uBA85\uC131 \uC2DC\uC2A4\uD15C\uC744 \uBC30\uC6B0\uACE0, \uBB34\uC5ED\uC758
      \uD070 \uADF8\uB9BC\uC744 \uADF8\uB838\uB2E4. \uBC31\uD638\uAC00 \uC5B4\uAE68\uC5D0\uC11C
      \uD0A5\uD0A5 \uC6C3\uC5C8\uB2E4."
  Blacksmith_B:
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uC5B8\uB2C8, \uC740\uD589 \uC5B8\uB2C8 \uCE5C\uC808\uD558\uB124! \uB2E4\uC74C\uC5D4
      \uB300\uC7A5\uAC04\uC73C\uB85C \uAC00\uBCF4\uC790!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uC640 \uBC31\uD638\uB294 \uC2DC\uC7A5 \uD55C\uCABD\uC5D0
      \uC790\uB9AC\uD55C \uB300\uC7A5\uAC04\uC73C\uB85C \uD5A5\uD588\uB2E4. \uB9DD\uCE58
      \uC18C\uB9AC\uAC00 \uC6B8\uB824 \uD37C\uC84C\uB2E4."
  Blacksmith_A:
  - SpeakerIndex: 0
    Name: "\uBC31\uD638"
    Dialog: "\uC5EC\uAE34 \uB300\uC7A5\uAC04\uC774\uC57C, \uC5B8\uB2C8! \uC5EC\uAE30\uC11C
      \uC9D0\uCE78\uC744 \uAD50\uCCB4\uD574\uC11C \uB354 \uB9CE\uC740 \uBB3C\uAC74\uC744
      \uB4E4\uACE0 \uB2E4\uB2D0 \uC218 \uC788\uC5B4. \uBB34\uC5ED\uD560 \uB54C \uC9D0\uCE78
      \uD06C\uAE30\uB294 \uC911\uC694\uD558\uAC70\uB4E0!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC9D0\uCE78 \uB298\uB9AC\uB294 \uAC70? \uC644\uC804 \uC720\uC6A9\uD574
      \uBCF4\uC774\uB124! \uC7A0\uAE50 \uAD6C\uACBD\uD560\uAE4C?"
  - SpeakerIndex: 0
    Name: "\uB300\uC7A5\uC7A5\uC774"
    Dialog: "\uC74C, \uC190\uB2D8\uC778\uAC00? \uC5EC\uAE34 \uB300\uC7A5\uAC04\uC774\uB2E4.
      \uC9D0\uCE78\uC744 \uAD50\uCCB4\uD574\uC11C \uC6A9\uB7C9\uC744 \uB298\uB9B4
      \uC218 \uC788\uC9C0. \uC9C0\uAE08 \uD544\uC694\uD55C \uAC8C \uC788\uB098?"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC548\uB155\uD558\uC138\uC694! \uC624\uB298\uC740 \uAD6C\uACBD\uC654\uC5B4\uC694.
      \uC544\uC9C1 \uC774\uAC83\uB3C4 \uC4F8\uB9CC \uD558\uB2E4\uACE0\uC694."
  - SpeakerIndex: 0
    Name: "\uB300\uC7A5\uC7A5\uC774"
    Dialog: "\uC9D0\uCE78\uC744 \uB354 \uD070 \uAC78\uB85C \uBC14\uAFB8\uBA74 \uB354
      \uB9CE\uC740 \uBB3C\uAC74\uC744 \uB4E4\uACE0 \uB2E4\uB2D0 \uC218 \uC788\uC744\uAC70\uB2E4.
      \uC790\uB124\uAC00 \uBA85\uC131\uC744 \uC313\uACE0 \uB2E4\uB2CC\uB2E4\uBA74
      \uB354 \uD070 \uC9D0\uCE78\uC5D0 \uB300\uD55C \uD5C8\uAC00\uB3C4 \uB0B4\uB824\uC904
      \uC218 \uC788\uC9C0."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC88B\uC544\uC694! \uB2E4\uC74C\uC5D0 \uCC3E\uC544\uC640\uC11C \uAF2D
      \uBC14\uAFC0\uAC8C\uC694!"
  - SpeakerIndex: 0
    Name: "\uB300\uC7A5\uC7A5\uC774"
    Dialog: "\uC88B\uC544, \uC5B8\uC81C\uB4E0\uC9C0 \uC624\uAC70\uB77C."
  - SpeakerIndex: 0
    Name: 
    Dialog: "\uBC31\uD638\uAC00 \uC5B4\uAE68\uC5D0\uC11C \uAF2C\uB9AC\uB97C \uC0B4\uB791\uAC70\uB838\uB2E4."
  MerchantGuild_B:
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uB2E4\uC74C\uC740 \uC0C1\uC778\uAE38\uB4DC\uC5D0 \uAC00\uBCF4\uC790!
      \uAC70\uAE30\uC11C \uD018\uC2A4\uD2B8 \uBC1B\uC744 \uC218 \uC788\uC5B4!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uC640 \uBC31\uD638\uB294 \uC2DC\uC7A5 \uD55C\uCABD\uC5D0
      \uC790\uB9AC\uD55C \uC0C1\uC778\uAE38\uB4DC \uAC74\uBB3C\uB85C \uD5A5\uD588\uB2E4.
      \uBB38 \uC704\uC5D4 \uC0C1\uC120\uACFC \uC218\uB808 \uBB38\uC591\uC774 \uC0C8\uACA8\uC838
      \uC788\uC5C8\uB2E4."
  MerchantGuild_A:
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uD018\uC2A4\uD2B8? \uC644\uC804 \uC7AC\uBC0C\uC5B4 \uBCF4\uC778\uB2E4!
      \uC5B4\uB5A4 \uAC8C \uC788\uB294\uC9C0 \uBCF4\uC5EC\uC918!"
  - SpeakerIndex: 0
    Name: "\uAE38\uB4DC\uC6D0"
    Dialog: "\uC548\uB155, \uC544\uAC00\uC528! \uC5EC\uAE34 \uC0C1\uC778\uAE38\uB4DC\uC57C.
      \uD018\uC2A4\uD2B8\uB85C \uB2E4\uB978 \uB9C8\uC744\uC5D0\uC11C \uBB3C\uAC74\uC744
      \uC0AC\uC624\uAC70\uB098 \uAC70\uB798\uD558\uBA74 \uBCF4\uC0C1\uC744 \uC918.
      \uAC8C\uC2DC\uD310\uC5D0 \uBB50 \uC788\uB294\uC9C0 \uBCFC\uB798?"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC751, \uBCF4\uC5EC\uC918! \uC5B4\uB514 \uC5B4\uB514\u2026 \uC640!
      \uB2E4\uC591\uD55C \uD018\uC2A4\uD2B8\uAC00 \uC788\uB124?"
  - SpeakerIndex: 0
    Name: "\uAE38\uB4DC\uC6D0"
    Dialog: "\uB9DE\uC544. \uC9C0\uAE08 \uC900\uBE44\uAC00 \uBD80\uC871\uD574\uB3C4
      \uAD1C\uCC2E\uC544. \uC5B8\uC81C\uB4E0 \uC218\uC8FC\uD560 \uC218 \uC788\uC9C0."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC774\uB807\uAC8C \uD018\uC2A4\uD2B8 \uBC1B\uB294 \uAC70\uAD6C\uB098!
      \uB098\uC911\uC5D0 \uAF2D \uB3C4\uC804\uD574\uBCFC\uAC8C\uC694!"
  - SpeakerIndex: 0
    Name: "\uAE38\uB4DC\uC6D0"
    Dialog: "\uC88B\uC544, \uAE30\uB300\uD560\uAC8C! \uD018\uC2A4\uD2B8\uB97C \uD558\uB2E4\uBCF4\uBA74
      \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uBA85\uC131\uC774 \uC624\uB97C\uAC70\uC57C!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uACE0\uB9C8\uC6CC, \uC544\uC800\uC528! \uB2E4\uC74C\uC5D4 \uD018\uC2A4\uD2B8
      \uAC00\uC9C0\uB7EC \uC62C\uAC8C\uC694!"
  - SpeakerIndex: 0
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uB294 \uC0C1\uC778\uAE38\uB4DC\uC5D0\uC11C \uD018\uC2A4\uD2B8\uC5D0
      \uB300\uD574 \uC54C\uC558\uB2E4. \uBC31\uD638\uAC00 \uC5B4\uAE68\uC5D0\uC11C
      \uAF2C\uB9AC\uB97C \uC0B4\uB791\uC600\uB2E4."
  TownHall_B:
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uB2E4\uC74C\uC740 \uB9C8\uC744\uD68C\uAD00\uC73C\uB85C \uAC00\uBCF4\uC790!
      \uAC70\uAE30\uC11C \uBA85\uC131\uC5D0 \uAD00\uD574 \uC54C \uC218 \uC788\uC5B4!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uC640 \uBC31\uD638\uB294 \uC2DC\uC7A5 \uD55C\uCABD\uC5D0
      \uC790\uB9AC\uD55C \uB9C8\uC744\uD68C\uAD00\uC73C\uB85C \uD5A5\uD588\uB2E4.
      \uAC74\uBB3C\uC740 \uD654\uB824\uD55C \uBB38\uC591\uC73C\uB85C \uC7A5\uC2DD\uB418\uC5B4
      \uC788\uC5C8\uB2E4."
  TownHall_A:
  - SpeakerIndex: 0
    Name: "\uBC31\uD638"
    Dialog: "\uC5EC\uAE30\uB294 \uB9C8\uC744\uD68C\uAD00\uC774\uC57C, \uC5B8\uB2C8!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC5EC\uAE30\uC11C\uB294 \uBB58 \uD558\uB294\uAC70\uC57C?"
  - SpeakerIndex: 0
    Name: "\uBC31\uD638"
    Dialog: "\uBB34\uC5ED\uC5D0\uC11C \uBB3C\uB860 \uD765\uC815\uB3C4 \uC911\uC694\uD558\uC9C0\uB9CC
      \uB354 \uC911\uC694\uD55C \uAC74 \uBA85\uC131\uC774\uB77C\uACE0. \uC5EC\uAE30\uC120
      \uBA85\uC131\uC744 \uD1B5\uD574 \uC5EC\uB7EC \uD61C\uD0DD\uB4E4\uC744 \uC5BB\uC744
      \uC218 \uC788\uC5B4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uD61C\uD0DD\uC774\uB77C\uBA74\u2026 \uD788\uD788 \uBB3C\uAC74\uC744
      \uC880 \uB354 \uC2F8\uAC8C \uC0B4 \uC218 \uC788\uB2E4\uAC70\uB098?"
  - SpeakerIndex: 0
    Name: "\uBC31\uD638"
    Dialog: "\uB9DE\uC544! \uBA85\uC131\uC774 \uB192\uC544\uC9C0\uBA74 \uD2B9\uC815
      \uBB3C\uAC74\uC5D0 \uB300\uD574 \uC2F8\uAC8C \uC0AC\uAC70\uB098 \uBE44\uC2F8\uAC8C
      \uD314 \uC218 \uC788\uC744 \uAC70\uC57C."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uAC70\uB798\uD560\uC218\uB85D \uC720\uB9AC\uD574\uC9C0\uB294 \uAC70\uC57C?
      \uBA85\uC131 \uC313\uC544\uC11C \uAF2D \uC640\uBD10\uC57C\uACA0\uB124!"
  - SpeakerIndex: 0
    Name: "\uBC31\uD638"
    Dialog: "\uC88B\uC544! \uC798\uD574\uBCF4\uB294\uAC70\uC57C!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uADF8\uB798! \uC794\uB729 \uC313\uC544\uC11C \uC624\uC790."
  - SpeakerIndex: 0
    Name: 
    Dialog: "\uBC31\uD638\uAC00 \uC5B4\uAE68\uC5D0\uC11C \uD0A5\uD0A5 \uC6C3\uC5C8\uB2E4."
  Tutorial_5:
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uC5B8\uB2C8, \uC0C1\uC778\uAE38\uB4DC\uB3C4 \uB05D! \uC774\uC81C \uC2DC\uC7A5
      \uB3CC\uC544\uAC00\uC11C \uAC70\uB798\uD558\uB7EC \uAC00\uC790! "
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC88B\uC544, \uBC31\uD638! \uC2DC\uC7A5\uC5D0\uC11C \uB354 \uD070 \uAC70\uB798\uB97C
      \uD558\uC790!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uC640 \uBC31\uD638\uB294 \uC2DC\uC7A5\uC758 \uD65C\uAE30
      \uC18D\uC5D0\uC11C \uB3CC\uC544\uAC14\uB2E4. \uD587\uC0B4 \uC544\uB798 \uB9C8\uC744\uC774
      \uC0DD\uAE30\uB85C \uBE5B\uB0AC\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uBC31\uD638, \uC624\uB298 \uD558\uB8E8 \uC9C4\uC9DC \uB300\uBC15\uC774\uC5C8\uC5B4!
      \uBB3C\uB860 \uC2E4\uD328\uB3C4 \uC788\uC5C8\uC9C0\uB9CC, \uC131\uACF5\uD560
      \uB54C \uC2EC\uC7A5\uC774 \uCFF5\uCFF5 \uB6F0\uC5C8\uC5B4!"
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uC5B8\uB2C8, \uCD08\uBCF4\uCE58\uACE4 \uC798\uD588\uC5B4! \uC5B4\uC5FF\uD55C
      \uBB34\uC5ED\uC0C1 \uAC19\uC558\uB294\uAC78?"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uBC31\uD638, \uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4? \uB098\uB294
      \uB108\uB791 \uAC19\uC774 \uC788\uC5B4\uC11C \uC9C4\uC9DC \uC7AC\uBC0C\uC5C8\uC5B4!"
  - SpeakerIndex: 2
    Name: "\uBC31\uD638"
    Dialog: "\uB098\uB3C4 \uC88B\uC558\uC5B4! \uC55E\uC73C\uB85C\uB3C4 \uCB49\uCB49
      \uAC70\uB798\uD558\uACE0 \uD6CC\uB96D\uD55C \uC0C1\uC778\uC774 \uB418\uB294
      \uAC70\uC57C!"
  - SpeakerIndex: 1
    Name: 
    Dialog: "\uBBF8\uB808\uC0AC\uC640 \uBC31\uD638\uB294 \uC2DC\uC7A5 \uB05D\uCABD
      \uB178\uC810\uC744 \uD5A5\uD574 \uC2DC\uC120\uC744 \uB3CC\uB838\uB2E4. \uD587\uC0B4
      \uC544\uB798 \uC0C8\uB85C\uC6B4 \uAE30\uD68C\uAC00 \uAE30\uB2E4\uB9B0\uB2E4."
  "\uBB34\uB69D\uB69D\uAC70\uB798\uC804\uC7A1\uB2F4":
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC548\uB155\uD558\uC138\uC694! \uC624\uB298 \uC2DC\uC7A5 \uC0AC\uB78C\uB4E4
      \uB9CE\uC544\uC11C \uC815\uC2E0\uC5C6\uC8E0? \uBB58 \uBCF4\uB7EC \uC624\uC168\uC5B4\uC694?"
  - SpeakerIndex: 4
    Name: "\uC190\uB2D8"
    Dialog: "\uD760, \uADF8\uB0E5\u2026 \uC774\uAC83\uC800\uAC83 \uBCF4\uB2E4\uAC00
      \uAC08 \uAC70\uC57C."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC624, \uADF8\uB798\uC694? \uD639\uC2DC \uC81C\uAC00 \uB531 \uB9DE\uB294
      \uAC70 \uCD94\uCC9C\uD574\uB4DC\uB9B4\uAE4C\uC694?"
  - SpeakerIndex: 4
    Name: "\uC190\uB2D8"
    Dialog: "\u2026\uBB50, \uC2DC\uAC04 \uC788\uC73C\uBA74 \uBCF4\uC9C0."
  "\uD654\uB09C\uC791\uBCC4\uC778\uC0AC":
  - SpeakerIndex: 4
    Name: "\uC190\uB2D8"
    Dialog: "\uD765, \uC774\uBC88\uC5D4 \uBCC4\uB85C\uC600\uC5B4. \uB098 \uAC04\uB2E4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uADF8\uB7FC \uB2E4\uC74C\uC5D4 \uB354 \uC798 \uB9DE\uCDB0\uBCFC\uAC8C\uC694!"
  - SpeakerIndex: 4
    Name: "\uC190\uB2D8"
    Dialog: "\uBB50, \uB450\uACE0 \uBCF4\uC9C0."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uD5E4\uD5E4, \uC5B8\uC81C\uB4E0 \uC640\uC8FC\uC138\uC694! \uAE30\uB2E4\uB9B4\uAC8C\uC694!"
  "\uBB34\uB69D\uB69D\uAC70\uB798\uAC70\uC808":
  - SpeakerIndex: 4
    Name: "\uC190\uB2D8"
    Dialog: "\uAC00\uACA9\uC774 \uC548 \uB9DE\uC544. \uC548 \uD574."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uD5C9, \uC9C4\uC9DC\uC694? \uC644\uC804 \uC88B\uC740\uB370, \uC870\uAE08
      \uB354 \uC870\uC815\uD574\uBCFC\uAE4C\uC694?"
  - SpeakerIndex: 4
    Name: "\uC190\uB2D8"
    Dialog: "\uB410\uC5B4. \uB2E4\uB978 \uB370 \uAC08\uAC8C."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC544\u2026 \uC54C\uACA0\uC5B4\uC694! \uB2E4\uC74C\uC5D4 \uB531 \uB9DE\uAC8C
      \uC900\uBE44\uD560\uAC8C\uC694!"
  "\uC720\uCF8C\uD55C\uC7AC\uD765\uC815":
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8 "
    Dialog: "\uD558\uD558, \uC544\uAC00\uC528, \uC870\uAE08\uB9CC \uC798 \uCCD0 \uC904\uC218
      \uC5C6\uACA0\uC5B4?"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC5C7, \uADF8\uB7FC \uC774 \uAC00\uACA9\uC740 \uC5B4\uB5A8\uAE4C\uC694?"
  "\uC544\uC774\uD15C\uC774\uB984\uCD9C\uB825":
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8"
    Dialog: "\uC5B4\uD5C8, \uB0B4\uAC00 \uC544\uBB34\uB9AC \uC138\uC0C1 \uBB3C\uC815\uC744
      \uBAB0\uB77C\uB3C4 [\uBB3C\uAC74\uC774\uB984][\uBAA9\uC801\uC5B4] [\uD765\uC815\uC81C\uC2DC\uAC00]\uACE8\uB4DC\uC5D0
      \uAC70\uB798\uD558\uB294\uAC8C \uC544\uB2C8\uB780 \uAC74 \uC54C\uC544."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "(\uC74C\u2026\uB9DD\uD588\uB2E4\u2026)"
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8"
    Dialog: "\uADF8\uB798\uB3C4 [\uD765\uC815\uC81C\uC2DC\uAC00]\uACE8\uB4DC\uBCF4\uB2E4\uB294
      \uC798 \uCCD0\uC904\uC21C \uC5C6\uACA0\uC5B4? \uB2F9\uC7A5 \uAE09\uD574\uC11C\uB9D0\uC774\uC57C."
  "\uC720\uCF8C\uD55C\uAC70\uB798\uC804\uC778\uC0AC":
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8"
    Dialog: "\uC624~ \uC0C1\uC778\uC544\uAC00\uC528\uAC00 \uC624\uB79C\uB9CC\uC5D0
      \uC654\uAD6C\uB9CC."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC548\uB155\uD558\uC138\uC694~ \uC694\uC998\uC5D0 \uC81C\uAC00 \uC870\uAE08
      \uBC14\uBE60\uC11C\u2026."
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8"
    Dialog: "\uC548\uADF8\uB798\uB3C4 \uB9C8\uCE68 \uC0AC\uACE0 \uD314\uAC8C \uC788\uC5C8\uB294\uB370,
      \uC798\uB410\uC5B4."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uD5E4\uD5F7~ \uC81C\uAC00 \uC88B\uC740\uAC00\uACA9\uC5D0 \uB9DE\uCDB0\uB4DC\uB9B4\uAC8C\uC694."
  "\uC720\uCF8C\uD55C\uAC70\uB798\uD6C4\uC778\uC0AC":
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8"
    Dialog: "\uC624\uB298\uB3C4 \uC88B\uC740\uAC70\uB798\uC600\uC5B4. \uAC00\uB054\uC529
      \uC624\uC9C0\uB9D0\uACE0 \uC790\uC8FC\uC790\uC8FC \uB4E4\uB824\uC918."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC800\uC57C\uB9D0\uB85C \uC88B\uC740 \uAC70\uB798 \uAC10\uC0AC\uD574\uC694~"
  "\uC544\uC800\uC528\uAC70\uB798\uC804\uC778\uC0AC":
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC88B\uC740 \uBB3C\uAC74\uC774 \uB9CE\uC774 \uC788\uC5B4\uC694~ \uB458\uB7EC\uBCF4\uC138\uC694~"
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8"
    Dialog: "\uC74C, \uADF8\uB798? \uD55C\uBC88 \uB458\uB7EC\uBCF4\uC9C0. \uC544,
      \uC774\uBB3C\uAC74 \uB300\uCDA9 \uC5BC\uB9C8\uCBE4 \uD560\uAC83\uAC19\uB098?"
  "\uC544\uC800\uC528\uAC70\uB798\uD6C4\uC778\uC0AC":
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8"
    Dialog: "\uD06C, \uC80A\uC740 \uC544\uAC00\uC528\uAC00 \uACE0\uC0DD\uC774 \uCC38
      \uB9CE\uC544, \uB098 \uB54C\uB3C4\u2026..."
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uB124~ \uC190\uB2D8. \uC88B\uC740 \uAC70\uB798 \uAC10\uC0AC\uD569\uB2C8\uB2E4~~"
  - SpeakerIndex: 2
    Name: "\uC190\uB2D8"
    Dialog: "\uC5B4, \uD06C\uD760. \uADF8\uB798. \uB2E4\uC74C\uC5D0\uB3C4 \uB610
      \uB4E4\uB824\uC918."
  "\uC18C\uB144\uAC70\uB798\uC804\uC778\uC0AC":
  - SpeakerIndex: 3
    Name: "\uC18C\uB144"
    Dialog: "\uC548\uB155\uD558\uC138\uC694 \uB204\uB098!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC5B4, \uAF2C\uB9C8\uC57C. \uBB34\uC2A8 \uC77C\uC774\uB2C8?"
  - SpeakerIndex: 3
    Name: "\uC190\uB2D8"
    Dialog: "\uC5C4\uB9C8\uAC00 \uC2EC\uBD80\uB984 \uC2DC\uCF1C\uC11C\uC694!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC751, \uCC9C\uCC9C\uD788 \uB458\uB7EC\uBCF4\uACE0 \uD544\uC694 \uD55C
      \uAC8C \uC788\uC73C\uBA74 \uB9D0\uD558\uB834."
  "\uC18C\uB144\uAC70\uB798\uD6C4\uC778\uC0AC":
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uB354 \uD544\uC694\uD55C \uAC74 \uC5C6\uB2C8?"
  - SpeakerIndex: 3
    Name: "\uC18C\uB144"
    Dialog: "\uB124 \uB204\uB098! \uC774\uAC70\uBA74 \uB420 \uAC83 \uAC19\uC544\uC694.
      \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uADF8\uB798~ \uB2E4\uC74C\uC5D0\uB3C4 \uB610 \uCC3E\uC544\uC624\uB834~!"
  "\uC18C\uB144\uC7AC\uD765\uC815":
  - SpeakerIndex: 3
    Name: "\uC18C\uB144"
    Dialog: "[\uBB3C\uAC74\uC774\uB984][\uC8FC\uACA9\uC870\uC0AC] \uC774\uC815\uB3C4
      \uAC00\uACA9\uC740 \uC544\uB2C8\uB77C\uACE0 \uD588\uB294\uB370.. \uD639\uC2DC
      \uD55C\uBC88\uB9CC \uB354 \uC0DD\uAC01 \uD574 \uC904 \uC218 \uC5C6\uC744\uAE4C\uC694..?"
  - SpeakerIndex: 0
    Name: "\uBBF8\uB808\uC0AC"
    Dialog: "\uC74C\u2026 \uC5B4\uB5BB\uAC8C \uD560\uAE4C..?"
